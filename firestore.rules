rules_version = '2';

// Team-only: anyone signed in through Firebase Auth can read and write every
// collection. Role permissions are enforced by the app's store (permissions.ts);
// this keeps the public out.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
